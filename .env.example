# ==============================================================================
# DEV CYCLE - SUPABASE AUTHENTICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Project Settings -> API to copy your Project URL and anon/public key.
# 3. Rename or copy this file to `.env` and fill in your credentials below.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public API Key (JWT)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
